# ---- Postgres ----
POSTGRES_USER=cmblab
POSTGRES_PASSWORD=cmblab_dev_password
POSTGRES_DB=cmblab
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- MinIO / S3 ----
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=cmblab
S3_SECRET_KEY=cmblab_dev_password
S3_BUCKET=cmblab
S3_REGION=us-east-1

# ---- Service ports ----
GATEWAY_PORT=8080
CATALOG_URL=http://localhost:8001
INGEST_URL=http://localhost:8002
SPECTRUM_URL=http://localhost:8003
COSMOLOGY_URL=http://localhost:8004
ANOMALY_URL=http://localhost:8005
LITERATURE_URL=http://localhost:8006

# ---- External APIs (both optional) ----

# Enables the AI physics assistant (stage 2). Free key: https://aistudio.google.com/apikey
# Leave blank to run the assistant in stage 1 (retrieval only) - it still answers questions.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Free token from https://ui.adsabs.harvard.edu/user/settings/token
ADS_API_TOKEN=

# ---- Runtime ----
LOG_LEVEL=INFO
DATA_DIR=./data
MAX_WORKERS=12
